#!/usr/bin/env python3
"""
Dikogit - Git CLI Extension for Commit Summaries on macOS
"""

import sys
import os
import subprocess
import argparse
import re
import pathlib
import json

VERSION = "1.1.0"

class DikogitsEngine:
    def __init__(self, repo_root=None):
        self.repo_root = repo_root or self._get_repo_root()

    def _get_repo_root(self):
        try:
            res = subprocess.run(
                ["git", "rev-parse", "--show-toplevel"],
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                text=True,
                check=True
            )
            return res.stdout.strip()
        except subprocess.CalledProcessError:
            return None

    def get_git_dir(self):
        if not self.repo_root:
            return None
        try:
            res = subprocess.run(
                ["git", "rev-parse", "--git-dir"],
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                text=True,
                check=True,
                cwd=self.repo_root
            )
            git_dir = res.stdout.strip()
            if not os.path.isabs(git_dir):
                git_dir = os.path.normpath(os.path.join(self.repo_root, git_dir))
            return git_dir
        except subprocess.CalledProcessError:
            return None

    def stage_all(self):
        """Stage all changed and untracked files with git add ."""
        if not self.repo_root:
            return False
        try:
            subprocess.run(
                ["git", "add", "."],
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                text=True,
                check=True,
                cwd=self.repo_root
            )
            return True
        except subprocess.CalledProcessError as e:
            err = e.stderr.strip() or e.stdout.strip()
            print(f"Error staging files: {err}", file=sys.stderr)
            return False

    def commit(self, summary):
        """Commit staged changes using generated summary"""
        if not self.repo_root or not summary:
            return None
        try:
            res = subprocess.run(
                ["git", "commit", "-m", summary['title'], "-m", summary['body']],
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                text=True,
                check=True,
                cwd=self.repo_root
            )
            return res.stdout.strip()
        except subprocess.CalledProcessError as e:
            err = e.stderr.strip() or e.stdout.strip()
            print(f"Error committing changes: {err}", file=sys.stderr)
            return None

    def auto_commit(self):
        """Automate git add . and commit with generated summary"""
        if not self.stage_all():
            return {"status": "stage_failed"}
        summary = self.generate_summary()
        if not summary:
            return {"status": "no_changes"}
        commit_output = self.commit(summary)
        if commit_output is None:
            return {"status": "commit_failed"}
        return {
            "status": "success",
            "summary": summary,
            "commit_output": commit_output
        }

    def get_staged_diff(self):
        try:
            res = subprocess.run(
                ["git", "diff", "--cached"],
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                text=True,
                check=True,
                cwd=self.repo_root
            )
            return res.stdout
        except subprocess.CalledProcessError:
            return ""

    def get_staged_numstat(self):
        try:
            res = subprocess.run(
                ["git", "diff", "--cached", "--numstat"],
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                text=True,
                check=True,
                cwd=self.repo_root
            )
            return res.stdout.strip()
        except subprocess.CalledProcessError:
            return ""

    def get_staged_name_status(self):
        try:
            res = subprocess.run(
                ["git", "diff", "--cached", "--name-status"],
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                text=True,
                check=True,
                cwd=self.repo_root
            )
            return res.stdout.strip()
        except subprocess.CalledProcessError:
            return ""

    def parse_changes(self):
        name_status = self.get_staged_name_status()
        numstat = self.get_staged_numstat()
        diff_text = self.get_staged_diff()

        files_changed = []
        additions_total = 0
        deletions_total = 0

        # Parse numstat
        numstat_map = {}
        for line in numstat.splitlines():
            parts = line.split('\t')
            if len(parts) >= 3:
                adds = int(parts[0]) if parts[0].isdigit() else 0
                dels = int(parts[1]) if parts[1].isdigit() else 0
                filepath = parts[2]
                numstat_map[filepath] = (adds, dels)
                additions_total += adds
                deletions_total += dels

        # Parse name-status
        for line in name_status.splitlines():
            parts = line.split('\t')
            if len(parts) >= 2:
                status_code = parts[0][0]  # M, A, D, R, C
                filepath = parts[-1]
                orig_filepath = parts[1] if len(parts) > 2 else filepath
                adds, dels = numstat_map.get(filepath, (0, 0))

                status_name = {
                    'A': 'added',
                    'M': 'modified',
                    'D': 'deleted',
                    'R': 'renamed',
                    'C': 'copied'
                }.get(status_code, 'changed')

                files_changed.append({
                    'status': status_name,
                    'code': status_code,
                    'path': filepath,
                    'orig_path': orig_filepath,
                    'additions': adds,
                    'deletions': dels
                })

        # Detect functional details from diff
        details = self._extract_diff_details(diff_text)

        return {
            'files': files_changed,
            'additions': additions_total,
            'deletions': deletions_total,
            'details': details
        }

    def _extract_diff_details(self, diff_text):
        details = []
        current_file = None
        
        for line in diff_text.splitlines():
            if line.startswith('diff --git'):
                match = re.search(r'b/(.+)$', line)
                if match:
                    current_file = match.group(1)
            elif line.startswith('+') and not line.startswith('+++'):
                content = line[1:].strip()
                # Look for function/class definitions or key constructs across languages
                if re.match(r'^(def |class |func |function |async def |export |pub fn |interface |type |const |let |var )', content):
                    details.append(f"Defined `{content[:60]}`")
                elif re.match(r'^(import |from |require\(|#include|use )', content):
                    details.append(f"Added import: `{content[:60]}`")
                elif content.startswith('#') and len(content) < 80:
                    details.append(f"Added section: `{content}`")
        
        # Deduplicate and limit
        seen = set()
        unique_details = []
        for d in details:
            if d not in seen:
                seen.add(d)
                unique_details.append(d)
        return unique_details[:5]

    def determine_commit_type(self, changes):
        files = changes['files']
        if not files:
            return "chore"

        paths = [f['path'].lower() for f in files]
        statuses = [f['status'] for f in files]

        # Test files
        if all('test' in p or 'spec' in p or p.startswith('tests/') for p in paths):
            return "test"

        # Documentation
        if all(p.endswith(('.md', '.rst', '.txt')) or 'docs/' in p or 'readme' in p for p in paths):
            return "docs"

        # CI / Config
        if all(p.endswith(('.yml', '.yaml', '.json', '.toml', '.ini')) or '.github/' in p or 'docker' in p for p in paths):
            return "chore"

        # Fix indicators in path or changes
        diff_text = self.get_staged_diff().lower()
        if 'fix' in diff_text or 'bug' in diff_text or 'error' in diff_text or 'patch' in diff_text:
            return "fix"

        # Added files usually mean new features
        if any(s == 'added' for s in statuses):
            return "feat"

        return "refactor" if any(s == 'modified' for s in statuses) else "chore"

    def generate_summary(self, style="conventional"):
        changes = self.parse_changes()
        files = changes['files']

        if not files:
            return None

        commit_type = self.determine_commit_type(changes)
        total_files = len(files)
        adds = changes['additions']
        dels = changes['deletions']

        # Determine primary scope
        scopes = set()
        for f in files:
            parts = pathlib.Path(f['path']).parts
            if len(parts) > 1:
                scopes.add(parts[0])
            else:
                scopes.add("root")
        
        scope_str = f"({', '.join(sorted(list(scopes))[:2])})" if scopes else ""

        # Build Title
        if total_files == 1:
            file_name = pathlib.Path(files[0]['path']).name
            summary_title = f"{commit_type}{scope_str}: update {file_name}"
        else:
            summary_title = f"{commit_type}{scope_str}: update {total_files} files (+{adds} -{dels})"

        # Build Body
        body_lines = []
        body_lines.append(f"### Dikogits Commit Summary")
        body_lines.append(f"- **Stats**: {total_files} file(s) changed, {adds} insertion(s)(+), {dels} deletion(s)(-)")
        
        body_lines.append("- **File Breakdown**:")
        for f in files[:10]:  # Limit to 10 files
            status_symbol = {
                'added': '[A]',
                'modified': '[M]',
                'deleted': '[D]',
                'renamed': '[R]',
                'copied': '[C]'
            }.get(f['status'], '[*]')
            body_lines.append(f"  - {status_symbol} `{f['path']}` (+{f['additions']} -{f['deletions']})")

        if len(files) > 10:
            body_lines.append(f"  - ... and {len(files) - 10} more files")

        if changes['details']:
            body_lines.append("- **Key Changes**:")
            for d in changes['details']:
                body_lines.append(f"  - {d}")

        return {
            'title': summary_title,
            'body': "\n".join(body_lines),
            'full_summary': f"{summary_title}\n\n" + "\n".join(body_lines)
        }


def main():
    parser = argparse.ArgumentParser(
        prog="git-dikogit",
        description="Dikogit: Automated commit summary generator and auto-commit CLI extension for Git"
    )
    parser.add_argument("-v", "--version", action="version", version=f"%(prog)s {VERSION}")

    subparsers = parser.add_subparsers(dest="command")

    # commit command (explicit subcommand for default behavior)
    subparsers.add_parser("commit", help="Stage all changes and commit directly with generated summary (default)")

    # generate command
    gen_parser = subparsers.add_parser("generate", help="Generate summary for current staged changes without committing")
    gen_parser.add_argument("--json", action="store_true", help="Output summary in JSON format")

    args = parser.parse_args()

    engine = DikogitsEngine()
    if not engine.repo_root:
        print("fatal: not a git repository (or any of the parent directories): .git", file=sys.stderr)
        sys.exit(1)

    # Default to auto_commit when no command is provided or 'commit' is explicitly used
    if args.command in (None, "commit"):
        res = engine.auto_commit()
        if res["status"] == "no_changes":
            print("No changes found to commit (working tree clean).", file=sys.stderr)
            sys.exit(1)
        elif res["status"] != "success":
            sys.exit(1)
        else:
            print("✓ Staged all changes (git add .)")
            print("✓ Committed with summary:\n")
            print(res["summary"]["full_summary"])
            if res["commit_output"]:
                print(f"\n{res['commit_output']}")
    elif args.command == "generate":
        summary = engine.generate_summary()
        if summary:
            if getattr(args, "json", False):
                print(json.dumps(summary, indent=2))
            else:
                print(summary['full_summary'])
        else:
            print("No staged changes found to summarize.", file=sys.stderr)
            sys.exit(1)
    else:
        parser.print_help()

if __name__ == "__main__":
    main()
