#!/bin/sh
# Dikogits pre-commit hook for macOS
# Automatically generates staged change summary before commit

if command -v git-dikogits >/dev/null 2>&1; then
    git-dikogits hook pre-commit
elif [ -f "$(dirname "$0")/../../bin/git-dikogits" ]; then
    "$(dirname "$0")/../../bin/git-dikogits" hook pre-commit
fi
